generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  APPROVER
  ADMIN
}

enum AttendanceStatus {
  OPEN       // 編集可
  SUBMITTED  // 本人確認済
  APPROVED   // 承認済
  LOCKED     // 締め済
}

enum RequestType {
  OVERTIME    // 残業申請
  LEAVE       // 休暇申請
  ABSENCE     // 欠勤・遅刻・早退
  CORRECTION  // 打刻修正申請
  COMMENT     // テキストのみの連絡
  OTHER
  BREAK       // 休憩申請（60分超・押し忘れ用）
  HOLIDAY_WORK // 休日出勤申請（振休・代休の区別はシステムが決める）
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalAction {
  APPROVED
  REJECTED
  SKIPPED   // 飛び越し承認で消化されたステップ
}

// 従業員マスタ（NextAuth Adapter 必須カラム含む）
model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  role             Role      @default(EMPLOYEE)
  approverStep     Int?      // APPROVER のみ: 1 or 2
  employeeCode     String?   @unique // 従業員コード（給与システム連携キー）
  department       String?
  jobTitle         String?   // 役職名
  employmentType   String    @default("full") // full / part
  workStartTime    String?   // "08:30"
  workEndTime      String?   // "17:30"
  hireDate         DateTime? // 入社日（有給付与計算用）
  salaryCode       String?   // 給与個人コード（給与ソフト連携用）
  companyEmail     String?   @unique // 会社メール（永続・管理者が登録）
  linkedAt         DateTime?         // Googleアカウント紐づけ日時
  isActive         Boolean   @default(true)
  // 所定出勤曜日（デフォルト月〜金）
  workSun          Boolean   @default(false)
  workMon          Boolean   @default(true)
  workTue          Boolean   @default(true)
  workWed          Boolean   @default(true)
  workThu          Boolean   @default(true)
  workFri          Boolean   @default(true)
  workSat          Boolean   @default(false)
  breakMinutes     Int?      // 本人の所定休憩（分・任意。空なら会社設定から求める）
  createdAt        DateTime  @default(now())

  attendanceRecords AttendanceRecord[]
  requests          Request[]
  approvals         Approval[]
  approvalRoutes    ApprovalRoute[]
  accounts          Account[]
  sessions          Session[]
  changeLogs        AttendanceChangeLog[]
}

// NextAuth 必須テーブル
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// 打刻記録
model AttendanceRecord {
  id             String           @id @default(cuid())
  userId         String
  date           DateTime         // 日付のみ (UTC 0時＝その日。人間は日本時間で読む。lib/date.ts 参照)
  clockIn        DateTime?
  clockOut       DateTime?
  breakStart     DateTime?  // パート: 休憩開始
  breakEnd       DateTime?  // パート: 休憩終了
  goOutAt        DateTime?  // 外出
  returnAt       DateTime?  // 戻り
  workingMinutes       Int?
  note                 String?
  status               AttendanceStatus @default(OPEN)
  isAbsent             Boolean   @default(false) // 欠勤フラグ
  scheduledStartTime   String?   // 欠勤時スナップショット（所定開始）
  scheduledEndTime     String?   // 欠勤時スナップショット（所定終了）
  // 原打刻（初回のみ保存・以降不変）
  originalClockIn      DateTime?
  originalClockOut     DateTime?
  // 生打刻（丸め適用前の実打刻時刻。打刻時に常に保存。手入力・修正では変更しない）
  rawClockIn           DateTime?
  rawClockOut          DateTime?
  // 承認/締め時に計算・確定する集計値
  lateMinutes          Int?      // 遅刻分
  earlyLeaveMinutes    Int?      // 早退分
  overtimeMinutes      Int?      // 残業分
  paidLeaveMinutes     Int?      // 有給取得時間（分）
  breakMinutes         Int?      // その日の休憩の分数（休憩ボタン・休憩申請の承認で入る）
  isHolidayWork        Boolean   @default(false) // 休日出勤の印（代理打刻の休日出勤チェック。承認し直しても遅刻・早退を0に保つ）
  // 打刻時点のスイッチ状態（①〜④）。計算し直すときはこの保存値を使う（遡及しない）。null＝保存値なし（既存の記録）
  // 保存値なしの記録は「③④OFF・①②は現在値」として扱う（lib/clock-pipeline.ts resolveSwitches）
  switchRoundEarly     Boolean?  // ① roundEarlyClockIn
  switchRoundNear      Boolean?  // ② roundNearClockTime
  switchRoundQuarter   Boolean?  // ③ roundQuarterHour
  switchCapOvertime    Boolean?  // ④ capOvertimeByRequest
  createdAt            DateTime  @default(now())
  updatedAt      DateTime         @updatedAt

  user       User                  @relation(fields: [userId], references: [id])
  changeLogs AttendanceChangeLog[]

  @@unique([userId, date])
}

// 打刻変更ログ
model AttendanceChangeLog {
  id          String   @id @default(cuid())
  recordId    String
  changedById String
  changedAt   DateTime @default(now())
  fieldName   String   // "clockIn" / "clockOut" など
  oldValue    String?  // HH:MM または null
  newValue    String?

  record    AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  changedBy User             @relation(fields: [changedById], references: [id])
}

// 各種申請
model Request {
  id         String        @id @default(cuid())
  userId     String
  type       RequestType
  targetDate DateTime
  detail     Json?         // 申請種別ごとの追加情報
  reason     String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  user      User       @relation(fields: [userId], references: [id])
  approvals Approval[]
}

// 申請承認の経路（部署ごと・step 昇順に承認していく）
// 経路未設定の部署は従来どおり一段階承認（ADMIN/APPROVER が直接承認）
model ApprovalRoute {
  id         String @id @default(cuid())
  department String // User.department と一致させる
  step       Int    // 1=一次承認者（上長）, 2=決裁者 ...（可変段数）
  approverId String
  approver   User   @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([department, step])
}

// 承認ログ（多段階）
model Approval {
  id         String         @id @default(cuid())
  requestId  String
  approverId String
  step       Int
  action     ApprovalAction
  comment    String?
  actedAt    DateTime       @default(now())

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User    @relation(fields: [approverId], references: [id])
}

// 有給残（手動管理）
model LeaveBalance {
  id         String @id @default(cuid())
  userId     String
  fiscalYear Int
  totalDays  Float
  usedDays   Float  @default(0)

  @@unique([userId, fiscalYear])
}

// 会社設定（シングルトン id=1）
model Setting {
  id               Int      @id @default(1)
  closingDay       Int      @default(25)  // 締め日（1-28）
  break1Threshold  Int      @default(360) // 休憩45分控除の閾値（分）= 6時間
  break1Minutes    Int      @default(45)  // 45分
  break2Threshold  Int      @default(480) // 休憩60分控除の閾値（分）= 8時間
  break2Minutes       Int      @default(60)    // 60分
  roundEarlyClockIn  Boolean  @default(false) // 定時前打刻→定時扱い
  roundNearClockTime Boolean  @default(false) // 定時±14分以内→定時きっかり
  roundQuarterHour   Boolean  @default(false) // ③15分丸め（出勤切り上げ・退勤切り捨て。本人の定時起点）
  capOvertimeByRequest Boolean @default(false) // ④残業の申請上限（退勤の記録時刻を最後の承認済み残業申請の終了、無ければ定時で頭打ち）
  lunchStartTime      String   @default("12:00") // 昼休憩の開始時刻。正社員の半休の境目を決めるためだけに使う（休憩控除の判定には使わない）
  legalHolidayWeekday Int      @default(0)       // 法定休日の曜日（0=日曜〜6=土曜）。仮置き（労務担当者に確認中）。休日出勤の担当が使う
  weekStartDay        Int      @default(0)       // 週の起算日（0=日曜〜6=土曜）。仮置き（労務担当者に確認中）。休日出勤の担当が使う
  updatedAt           DateTime @updatedAt
}

// 休日カレンダー（残業・休出判定の元データ）
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique // 日付のみ (UTC 0時＝その日。人間は日本時間で読む。lib/date.ts 参照)
  name      String           // 例: "元日"、"夏季休業"
  type      String   @default("NATIONAL") // NATIONAL / COMPANY / SUBSTITUTE
  createdAt DateTime @default(now())
}
