generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  APPROVER
  ADMIN
}

enum AttendanceStatus {
  OPEN       // 編集可
  SUBMITTED  // 本人確認済
  APPROVED   // 承認済
  LOCKED     // 締め済
}

enum RequestType {
  OVERTIME    // 残業申請
  LEAVE       // 休暇申請
  ABSENCE     // 欠勤・遅刻・早退
  CORRECTION  // 打刻修正申請
  COMMENT     // テキストのみの連絡
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

// 従業員マスタ（NextAuth Adapter 必須カラム含む）
model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  role             Role      @default(EMPLOYEE)
  approverStep     Int?      // APPROVER のみ: 1 or 2
  employeeCode     String?   @unique // 従業員コード（給与システム連携キー）
  department       String?
  jobTitle         String?   // 役職名
  employmentType   String    @default("full") // full / part
  workStartTime    String?   // "08:30"
  workEndTime      String?   // "17:30"
  hireDate         DateTime? // 入社日（有給付与計算用）
  salaryCode       String?   // 給与個人コード（給与ソフト連携用）
  companyEmail     String?   @unique // 会社メール（永続・管理者が登録）
  linkedAt         DateTime?         // Googleアカウント紐づけ日時
  isActive         Boolean   @default(true)
  // 所定出勤曜日（デフォルト月〜金）
  workSun          Boolean   @default(false)
  workMon          Boolean   @default(true)
  workTue          Boolean   @default(true)
  workWed          Boolean   @default(true)
  workThu          Boolean   @default(true)
  workFri          Boolean   @default(true)
  workSat          Boolean   @default(false)
  createdAt        DateTime  @default(now())

  attendanceRecords AttendanceRecord[]
  requests          Request[]
  approvals         Approval[]
  accounts          Account[]
  sessions          Session[]
  changeLogs        AttendanceChangeLog[]
}

// NextAuth 必須テーブル
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// 打刻記録
model AttendanceRecord {
  id             String           @id @default(cuid())
  userId         String
  date           DateTime         // 日付のみ (00:00:00 JST)
  clockIn        DateTime?
  clockOut       DateTime?
  breakStart     DateTime?  // パート: 休憩開始
  breakEnd       DateTime?  // パート: 休憩終了
  goOutAt        DateTime?  // 外出
  returnAt       DateTime?  // 戻り
  workingMinutes       Int?
  note                 String?
  status               AttendanceStatus @default(OPEN)
  isAbsent             Boolean   @default(false) // 欠勤フラグ
  scheduledStartTime   String?   // 欠勤時スナップショット（所定開始）
  scheduledEndTime     String?   // 欠勤時スナップショット（所定終了）
  // 原打刻（初回のみ保存・以降不変）
  originalClockIn      DateTime?
  originalClockOut     DateTime?
  // 承認/締め時に計算・確定する集計値
  lateMinutes          Int?      // 遅刻分
  earlyLeaveMinutes    Int?      // 早退分
  overtimeMinutes      Int?      // 残業分
  paidLeaveMinutes     Int?      // 有給取得時間（分）
  createdAt            DateTime  @default(now())
  updatedAt      DateTime         @updatedAt

  user       User                  @relation(fields: [userId], references: [id])
  changeLogs AttendanceChangeLog[]

  @@unique([userId, date])
}

// 打刻変更ログ
model AttendanceChangeLog {
  id          String   @id @default(cuid())
  recordId    String
  changedById String
  changedAt   DateTime @default(now())
  fieldName   String   // "clockIn" / "clockOut" など
  oldValue    String?  // HH:MM または null
  newValue    String?

  record    AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  changedBy User             @relation(fields: [changedById], references: [id])
}

// 各種申請
model Request {
  id         String        @id @default(cuid())
  userId     String
  type       RequestType
  targetDate DateTime
  detail     Json?         // 申請種別ごとの追加情報
  reason     String?
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  user      User       @relation(fields: [userId], references: [id])
  approvals Approval[]
}

// 承認ログ（多段階）
model Approval {
  id         String         @id @default(cuid())
  requestId  String
  approverId String
  step       Int
  action     ApprovalAction
  comment    String?
  actedAt    DateTime       @default(now())

  request  Request @relation(fields: [requestId], references: [id])
  approver User    @relation(fields: [approverId], references: [id])
}

// 有給残（手動管理）
model LeaveBalance {
  id         String @id @default(cuid())
  userId     String
  fiscalYear Int
  totalDays  Float
  usedDays   Float  @default(0)

  @@unique([userId, fiscalYear])
}

// 会社設定（シングルトン id=1）
model Setting {
  id               Int      @id @default(1)
  closingDay       Int      @default(25)  // 締め日（1-28）
  break1Threshold  Int      @default(360) // 休憩45分控除の閾値（分）= 6時間
  break1Minutes    Int      @default(45)  // 45分
  break2Threshold  Int      @default(480) // 休憩60分控除の閾値（分）= 8時間
  break2Minutes    Int      @default(60)  // 60分
  updatedAt        DateTime @updatedAt
}

// 休日カレンダー（残業・休出判定の元データ）
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique // 日付のみ (00:00:00 JST)
  name      String           // 例: "元日"、"夏季休業"
  type      String   @default("NATIONAL") // NATIONAL / COMPANY / SUBSTITUTE
  createdAt DateTime @default(now())
}
